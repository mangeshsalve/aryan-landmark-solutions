# compiled output
/dist
/node_modules
/build

# env
.env
.env.local
.env.*.local
.dev.vars

# Cloudflare Worker local state (Phase 1/2 D1 schema validation — never
# committed, holds only local-only test data, no real credentials)
.wrangler/

# Phase 10 migration tooling's working data — real exported rows (even
# from a local/test database) must never be committed; the tooling
# itself lives in scripts/migration/, only its output does not.
scripts/migration/migration-data/

# scripts/production/'s temporary per-run SQL files (deleted immediately
# after each wrangler invocation, but ignored as defense in depth).
scripts/production/tmp/

# logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store

# tests
/coverage
/.nyc_output

# IDEs
.idea
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.tsbuildinfo

# Prisma
prisma/dev.db
