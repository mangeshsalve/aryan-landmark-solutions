# Aryan Landmark Solutions — Backend Environment Variables
# Auth (JWT_*) variables are consumed by Phase 2 (authentication).
# R2 (CLOUDFLARE_R2_*) variables are consumed by Phase 5 (attachments) but
# are all OPTIONAL — leave them blank and the app still starts normally;
# R2-dependent endpoints return a clear STORAGE_UPLOAD_FAILED /
# "not configured" error instead of attempting a real Cloudflare call.

NODE_ENV=development
PORT=3000

# --- Database (Prisma / PostgreSQL) ---
# In production, if the target Postgres requires TLS or connection-pool
# tuning, append them as query params — Prisma reads these directly from
# the URL, no code change needed, e.g.:
#   ?sslmode=require&connection_limit=10&pool_timeout=10
# The exact values (whether SSL is required/verify-full, sensible pool
# size) depend on the hosting provider — set per environment, not guessed
# here.
DATABASE_URL=postgresql://postgres:password@localhost:5432/aryan_landmark

# --- CORS ---
# Comma-separated list of allowed browser origins (e.g.
# https://app.example.com,https://admin.example.com — the public website
# and any browser-based admin UI). Empty means no browser origin is
# allowed (enableCors is called with origin:false when this is unset —
# fails closed, not open). This only affects browser clients: the Flutter
# mobile app is not subject to CORS at all (CORS is a browser-enforced
# mechanism) and needs no entry here.
CORS_ORIGIN=

# --- Logging ---
# One of: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# --- Authentication ---
# Two independent signing secrets — an application (ADMIN/EMPLOYEE) token
# and a master token are never interchangeable, by design (see
# src/auth/services/token.service.ts). No refresh-token variable: the
# final architecture does not use refresh-token authentication.
# Generate real values with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-16-chars
MASTER_JWT_ACCESS_SECRET=change-me-to-a-different-random-string

# --- Cloudflare R2 (unified attachments module) ---
# All optional — leave blank until real credentials are available. Do
# NOT put real credentials in this example file; set them in your local
# untracked .env instead.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_BASE_URL=

# --- Attachments ---
# Max upload size in bytes, applied uniformly to PHOTO/DOCUMENT/RECORDING.
# Not specified in the authoritative documents — flagged as a decision in
# the Phase 5 report. Default: 25 MB.
ATTACHMENT_MAX_FILE_SIZE_BYTES=26214400
