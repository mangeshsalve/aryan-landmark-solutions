generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 1. users — APPLICATION_USER (ADMIN/EMPLOYEE), CUSTOMER, or MASTER.
/// Identity shape is enforced by chk_users_identity in schema.sql; Phase 1
/// creates the table only — no auth logic reads/writes it yet.
model User {
  id                  String              @id @default(uuid()) @db.Uuid
  userId              String?             @unique @map("user_id") @db.VarChar(50)
  userType            UserType            @map("user_type")
  role                ApplicationRole?
  name                String              @db.VarChar(150)
  email               String?             @unique @db.VarChar(255)
  mobile              String?             @db.VarChar(20)
  alternateMobile     String?             @map("alternate_mobile") @db.VarChar(20)
  address             String?
  city                String?             @db.VarChar(100)
  state               String?             @db.VarChar(100)
  pincode             String?             @db.VarChar(10)
  passwordHash        String?             @map("password_hash")
  status              UserStatus          @default(ACTIVE)
  lastLoginAt         DateTime?           @map("last_login_at") @db.Timestamptz(6)
  createdAt           DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUserId     String?             @map("created_by") @db.Uuid
  updatedByUserId     String?             @map("updated_by") @db.Uuid
  uploadedAttachments Attachment[]        @relation("AttachmentUploadedBy")
  auditLogs           AuditLog[]
  assignedInquiries   Inquiry[]           @relation("InquiryAssignedTo")
  createdInquiries    Inquiry[]           @relation("InquiryCreatedBy")
  customerInquiries   Inquiry[]           @relation("InquiryCustomer")
  handledInquiries    Inquiry[]           @relation("InquiryHandledBy")
  updatedInquiries    Inquiry[]           @relation("InquiryUpdatedBy")
  assignmentsFrom     InquiryAssignment[] @relation("AssignmentFrom")
  assignmentsTo       InquiryAssignment[] @relation("AssignmentTo")
  createdAssignments  InquiryAssignment[] @relation("AssignmentCreatedBy")
  createdProperties   Property[]          @relation("PropertyCreatedBy")
  updatedProperties   Property[]          @relation("PropertyUpdatedBy")
  createdFollowUps    FollowUp[]          @relation("FollowUpCreatedBy")
  updatedFollowUps    FollowUp[]          @relation("FollowUpUpdatedBy")
  notifications       Notification[]
  createdBy           User?               @relation("UserCreatedBy", fields: [createdByUserId], references: [id])
  createdUsers        User[]              @relation("UserCreatedBy")
  updatedBy           User?               @relation("UserUpdatedBy", fields: [updatedByUserId], references: [id])
  updatedUsers        User[]              @relation("UserUpdatedBy")

  @@index([mobile], map: "idx_users_mobile")
  @@index([userType, status], map: "idx_users_type_status")
  @@map("users")
}

/// 2. properties
model Property {
  id              String           @id @default(uuid()) @db.Uuid
  propertyCode    String           @unique @map("property_code") @db.VarChar(50)
  propertyType    String           @map("property_type") @db.VarChar(50)
  category        PropertyCategory
  area            Decimal?         @db.Decimal(14, 2)
  /// Controlled list as of this phase (was free-text VARCHAR — existing
  /// values normalized by migration, see that migration's header for the
  /// exact mapping). SQ_FT/ACRE/GUNTHA/HECTARE — an India-relevant set
  /// covering both small residential/commercial plots and large
  /// agricultural land.
  areaUnit        PropertyAreaUnit?  @map("area_unit")
  price           Decimal?         @db.Decimal(18, 2)
  /// Not client-settable as of this phase — this application is
  /// India-only, price is always INR; PropertiesService.create() hardcodes
  /// 'INR' rather than reading it from the request. Column/value kept
  /// (not dropped) for backward compatibility — every existing row is
  /// already 'INR' anyway.
  priceUnit       String?          @map("price_unit") @db.VarChar(20)
  gatNoDetails    String?          @map("gat_no_details") @db.VarChar(255)
  description     String?
  address         String?
  locality        String?          @db.VarChar(150)
  city            String?          @db.VarChar(100)
  state           String?          @db.VarChar(100)
  pincode         String?          @db.VarChar(10)
  latitude        Decimal?         @db.Decimal(10, 7)
  longitude       Decimal?         @db.Decimal(10, 7)
  mapUrl          String?          @map("map_url")
  status          PropertyStatus   @default(AVAILABLE)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUserId String?          @map("created_by") @db.Uuid
  updatedByUserId String?          @map("updated_by") @db.Uuid
  isPublic        Boolean?         @map("is_public")
  attachments     Attachment[]
  inquiries       Inquiry[]
  createdBy       User?            @relation("PropertyCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy       User?            @relation("PropertyUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([status], map: "idx_properties_status")
  @@index([city], map: "idx_properties_city")
  @@index([category], map: "idx_properties_category")
  @@map("properties")
}

/// 3. inquiries
model Inquiry {
  id                String              @id @default(uuid()) @db.Uuid
  inquiryNumber     String              @unique @map("inquiry_number") @db.VarChar(50)
  /// Nullable as of Phase 13B — an ADMIN can create a lightweight,
  /// call-driven inquiry (customerId/propertyId both NULL) before the
  /// customer or property has been identified. See Phase 13B report.
  customerId        String?             @map("customer_id") @db.Uuid
  propertyId        String?             @map("property_id") @db.Uuid
  /// BUYER or SELLER — see Phase 11 report for the migration from the
  /// prior free-text `type` values ("Sell"/"SELL") to this enum.
  type              InquiryType?
  priority          InquiryPriority     @default(MEDIUM)
  status            InquiryStatus       @default(NEW)
  externalReference String?             @map("external_reference") @db.VarChar(255)
  handledByUserId   String?             @map("handled_by_user_id") @db.Uuid
  assignedToUserId  String?             @map("assigned_to_user_id") @db.Uuid
  remarks           String?
  isPublic          Boolean             @default(false) @map("is_public")
  /// Unified location fields (this phase) — used by BOTH BUYER and SELLER
  /// inquiries, replacing the old BUYER-only preferredCity/preferredPincode.
  /// For BUYER: directly client-editable, the buyer's stated preference.
  /// For SELLER: authoritatively synced from the linked Property whenever
  /// propertyId is set/changed (InquiriesService) or whenever the linked
  /// property's own location fields are edited (PropertiesService
  /// propagates to every SELLER inquiry referencing it) — never
  /// independently client-editable while a property is linked, and
  /// preserved (not cleared) if the property is later deleted. See this
  /// phase's report for the full sync-rule rationale.
  city              String?             @db.VarChar(100)
  state             String?             @db.VarChar(100)
  pincode           String?             @db.VarChar(10)
  /// Locality/area text (this phase) — for SELLER, synced from
  /// Property.locality only (never Property.address — kept null if the
  /// property has no locality set, per this phase's explicit decision).
  /// Used as the fuzzy/token-matching signal alongside city; not required
  /// to be present for a match (locality-less inquiries fall back to the
  /// city signal alone).
  locality          String?             @db.VarChar(150)
  /// Maximum price the buyer is willing to pay, directly comparable to
  /// Property.price (same Decimal(18,2) precision, same implicit
  /// currency/unit — see Phase 11 report Part 3 for why no separate
  /// budget-unit field was added.
  maxBudget         Decimal?            @map("max_budget") @db.Decimal(18, 2)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUserId   String              @map("created_by") @db.Uuid
  updatedByUserId   String?             @map("updated_by") @db.Uuid
  attachments       Attachment[]
  assignedTo        User?               @relation("InquiryAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy         User                @relation("InquiryCreatedBy", fields: [createdByUserId], references: [id])
  customer          User?               @relation("InquiryCustomer", fields: [customerId], references: [id])
  handledBy         User?               @relation("InquiryHandledBy", fields: [handledByUserId], references: [id])
  property          Property?           @relation(fields: [propertyId], references: [id])
  updatedBy         User?               @relation("InquiryUpdatedBy", fields: [updatedByUserId], references: [id])
  assignments       InquiryAssignment[]
  submittedAt       DateTime?           @map("submitted_at")
  followUps         FollowUp[]
  @@index([customerId], map: "idx_inquiries_customer")
  @@index([propertyId], map: "idx_inquiries_property")
  @@index([status], map: "idx_inquiries_status")
  @@index([assignedToUserId], map: "idx_inquiries_assigned")
  @@index([handledByUserId], map: "idx_inquiries_handled")
  @@index([isPublic], map: "idx_inquiries_public")
  @@index([createdAt(sort: Desc)], map: "idx_inquiries_created")
  @@index([type], map: "idx_inquiries_type")
  /// This phase — pincode is now the mandatory matching gate for both
  /// directions (was city, via a join through Property, for the SELLER
  /// side); indexed directly since it's a plain Inquiry column now.
  @@index([type, pincode], map: "idx_inquiries_type_pincode")
  @@map("inquiries")
}

/// 4. attachments — unified PHOTO / DOCUMENT / RECORDING metadata table.
/// Relationship and document-type rules are enforced by
/// chk_attachment_relationship / chk_attachment_document_type in schema.sql.
/// As of Phase 13B: PHOTO/DOCUMENT require property_id OR inquiry_id (not
/// both); RECORDING still requires inquiry_id only. See Phase 13B report.
model Attachment {
  id               String         @id @default(uuid()) @db.Uuid
  propertyId       String?        @map("property_id") @db.Uuid
  inquiryId        String?        @map("inquiry_id") @db.Uuid
  attachmentType   AttachmentType @map("attachment_type")
  documentType     DocumentType?  @map("document_type")
  fileName         String         @map("file_name") @db.VarChar(255)
  mimeType         String         @map("mime_type") @db.VarChar(150)
  fileSizeBytes    BigInt?        @map("file_size_bytes")
  r2Bucket         String         @map("r2_bucket") @db.VarChar(255)
  r2ObjectKey      String         @unique @map("r2_object_key") @db.VarChar(1024)
  fileUrl          String?        @map("file_url")
  isPrimary        Boolean        @default(false) @map("is_primary")
  displayOrder     Int            @default(0) @map("display_order")
  uploadedByUserId String         @map("uploaded_by") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  inquiry          Inquiry?       @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  property         Property?      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedBy       User           @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id])

  @@index([propertyId], map: "idx_attachments_property")
  @@index([inquiryId], map: "idx_attachments_inquiry")
  @@index([attachmentType], map: "idx_attachments_type")
  @@index([inquiryId, attachmentType], map: "idx_attachments_inquiry_type")
  @@map("attachments")
}

/// 5. inquiry_assignments — assignment/reassignment history.
/// Current assignment lives on inquiries.assigned_to_user_id; this table
/// is the append-only history.
model InquiryAssignment {
  id                 String   @id @default(uuid()) @db.Uuid
  inquiryId          String   @map("inquiry_id") @db.Uuid
  assignedFromUserId String?  @map("assigned_from_user_id") @db.Uuid
  assignedToUserId   String   @map("assigned_to_user_id") @db.Uuid
  assignedAt         DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  reason             String?
  createdByUserId    String   @map("created_by") @db.Uuid
  assignedFrom       User?    @relation("AssignmentFrom", fields: [assignedFromUserId], references: [id])
  assignedTo         User     @relation("AssignmentTo", fields: [assignedToUserId], references: [id])
  createdBy          User     @relation("AssignmentCreatedBy", fields: [createdByUserId], references: [id])
  inquiry            Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  @@index([inquiryId, assignedAt(sort: Desc)], map: "idx_inquiry_assignments_inquiry")
  @@map("inquiry_assignments")
}

/// 6. follow_ups — Phase 16A. Explicitly authorized 7th table: CLAUDE.md's
/// "exactly 6 tables" constraint holds only absent an explicit,
/// unambiguous instruction to add one, and this phase is exactly that
/// instruction (dedicated to designing this entity). One inquiry has many
/// follow-ups; a follow-up always belongs to exactly one inquiry (unlike
/// attachments, there is no lightweight/ownerless case here — a follow-up
/// is only ever created against an inquiry that already exists).
model FollowUp {
  id               String         @id @default(uuid()) @db.Uuid
  inquiryId        String         @map("inquiry_id") @db.Uuid
  /// Single combined date+time instant (TIMESTAMPTZ), not separate date/
  /// time columns — matches every other date+time field in this schema
  /// (submittedAt, assignedAt, createdAt...). The old web UI's separate
  /// Date/Time form fields are a client-side concern; Flutter combines
  /// them into one ISO-8601 value before sending.
  scheduledAt      DateTime       @map("scheduled_at") @db.Timestamptz(6)
  status           FollowUpStatus @default(PENDING)
  notes            String?
  reminderEnabled  Boolean        @default(false) @map("reminder_enabled")
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUserId  String         @map("created_by") @db.Uuid
  updatedByUserId  String?        @map("updated_by") @db.Uuid
  inquiry          Inquiry        @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  createdBy        User           @relation("FollowUpCreatedBy", fields: [createdByUserId], references: [id])
  updatedBy        User?          @relation("FollowUpUpdatedBy", fields: [updatedByUserId], references: [id])

  @@index([inquiryId], map: "idx_follow_ups_inquiry")
  @@index([scheduledAt], map: "idx_follow_ups_scheduled")
  @@map("follow_ups")
}

/// 7. notifications — in-app notifications (this phase). 8th table,
/// same explicit-instruction carve-out as follow_ups (Phase 16A) from
/// CLAUDE.md's "exactly 6 tables" constraint. Generic on purpose — same
/// entityType/entityId + free-text `type` shape as audit_logs, since this
/// is the same kind of system-generated event record, just recipient-
/// scoped and user-facing instead of an admin trail. Started with exactly
/// one producer (ADMIN inquiry assignment) but not hardcoded to it, so a
/// second notification type later doesn't need a redesign.
model Notification {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  type       String    @db.VarChar(50)
  title      String    @db.VarChar(255)
  message    String
  entityType String?   @map("entity_type") @db.VarChar(100)
  entityId   String?   @map("entity_id") @db.Uuid
  isRead     Boolean   @default(false) @map("is_read")
  readAt     DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt(sort: Desc)], map: "idx_notifications_user")
  @@map("notifications")
}

/// 8. audit_logs
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  entityType String   @map("entity_type") @db.VarChar(100)
  entityId   String?  @map("entity_id") @db.Uuid
  action     String   @db.VarChar(100)
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId, createdAt(sort: Desc)], map: "idx_audit_entity")
  @@index([userId, createdAt(sort: Desc)], map: "idx_audit_user")
  @@map("audit_logs")
}

enum UserType {
  APPLICATION_USER
  CUSTOMER
  MASTER

  @@map("user_type")
}

enum ApplicationRole {
  ADMIN
  EMPLOYEE

  @@map("application_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED

  @@map("user_status")
}

enum PropertyCategory {
  RESIDENTIAL
  INDUSTRIAL
  COMMERCIAL
  AGRICULTURAL

  @@map("property_category")
}

enum PropertyStatus {
  AVAILABLE
  SOLD
  ON_HOLD
  INACTIVE

  @@map("property_status")
}

/// Controlled list for properties.area_unit — SQ_FT/SQ_YD/SQ_M for
/// residential/commercial-scale listings, ACRE/GUNTHA/HECTARE for
/// agricultural land (properties.category includes AGRICULTURAL).
/// Existing free-text data before the phase that introduced this enum was
/// inconsistent (`SQ.FT`/`sq.ft`/`SQ FT`) — normalized to SQ_FT by that
/// migration; see its header comment. SQ_YD/SQ_M added later, purely
/// additive (Postgres `ALTER TYPE ... ADD VALUE`) — see the migration that
/// added them.
enum PropertyAreaUnit {
  SQ_FT
  SQ_YD
  SQ_M
  ACRE
  GUNTHA
  HECTARE

  @@map("property_area_unit")
}

enum AttachmentType {
  PHOTO
  DOCUMENT
  RECORDING

  @@map("attachment_type")
}

enum DocumentType {
  SEVEN_TWELVE
  SALE_DEED
  PROPERTY_CARD
  NOC
  OTHER

  @@map("document_type")
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED

  @@map("inquiry_status")
}

enum InquiryPriority {
  LOW
  MEDIUM
  HIGH
  URGENT

  @@map("inquiry_priority")
}

/// Phase 11 — replaces the prior free-text Inquiry.type. Only two values:
/// a third (e.g. "RENT") is out of scope for the current matching
/// requirement and was not requested.
enum InquiryType {
  BUYER
  SELLER

  @@map("inquiry_type")
}

/// Phase 16A — matches the old web UI exactly. Deliberately just these
/// two: CANCELLED/MISSED/RESCHEDULED/OVERDUE were considered and rejected
/// per this phase's own instructions (no evidence they're required).
enum FollowUpStatus {
  PENDING
  COMPLETED

  @@map("follow_up_status")
}
