erDiagram

    USERS ||--o{ PROPERTIES : creates
    USERS ||--o{ INQUIRIES : customer
    USERS ||--o{ INQUIRIES : handles
    USERS ||--o{ INQUIRIES : assigned_to
    USERS ||--o{ INQUIRIES : creates

    PROPERTIES ||--o{ INQUIRIES : referenced_by

